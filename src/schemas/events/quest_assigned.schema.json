{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestAssignedPayload",
  "description": "A durable fact recording the assignment of a quest to a learner.",
  "type": "object",
  "required": [
    "assignment_id",
    "quest_id",
    "quest_definition_version",
    "assigned_at",
    "deadline_at"
  ],
  "properties": {
    "assignment_id": {
      "type": "string",
      "pattern": "^quest:.+$",
      "description": "Stable business identity, exactly quest:{quest_id}."
    },
    "quest_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier of the assigned quest."
    },
    "quest_definition_version": {"type": "string", "minLength": 1},
    "assigned_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
