{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestCompletedPayload",
  "description": "A durable fact recording the completion of a quest by a learner.",
  "type": "object",
  "required": [
    "completion_id",
    "assignment_id",
    "quest_id",
    "completed_at"
  ],
  "properties": {
    "completion_id": {
      "type": "string",
      "pattern": "^quest-completed:.+$",
      "description": "Stable business identity, exactly quest-completed:{quest_id}."
    },
    "assignment_id": {"type": "string", "minLength": 1},
    "quest_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier of the completed quest."
    },
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
