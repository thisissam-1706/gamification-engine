{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CohortDefinition",
  "type": "object",
  "required": [
    "cohort_id",
    "strategy",
    "epoch",
    "min_size",
    "max_size"
  ],
  "properties": {
    "cohort_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the cohort."
    },
    "strategy": {
      "type": "string",
      "enum": ["activity_volume", "course_module"],
      "description": "Grouping strategy used for cohort formation."
    },
    "epoch": {
      "type": ["string", "integer"],
      "description": "Calendar week or versioned epoch identifier (e.g. '2026-W41' or 202641)."
    },
    "min_size": {
      "type": "integer",
      "minimum": 1,
      "default": 500,
      "description": "Minimum active members required (default 500)."
    },
    "max_size": {
      "type": "integer",
      "minimum": 1,
      "default": 5000,
      "description": "Maximum active members allowed (default 5000)."
    },
    "status": {
      "type": "string",
      "enum": ["forming", "active", "finalized"],
      "default": "forming",
      "description": "Lifecycle status of the cohort."
    }
  },
  "additionalProperties": false
}
