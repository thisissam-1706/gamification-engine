{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streak Updated payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["completion_id", "previous_streak", "new_streak", "activity_date", "freezes_consumed", "freezes_remaining", "rule_version", "revision", "supersedes"],
  "properties": {
    "completion_id": {
      "type": "string",
      "minLength": 1,
      "description": "The accepted dated completion that caused this recalculation."
    },
    "previous_streak": {"type": "integer", "minimum": 0},
    "new_streak": {"type": "integer", "minimum": 1},
    "activity_date": {"type": "string", "format": "date"},
    "freezes_consumed": {"type": "integer", "minimum": 0},
    "freezes_remaining": {"type": "integer", "minimum": 0},
    "rule_version": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": ["string", "null"]}
  }
}
