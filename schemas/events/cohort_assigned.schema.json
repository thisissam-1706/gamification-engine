{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CohortAssignedPayload",
  "type": "object",
  "required": [
    "cohort_id",
    "membership_epoch",
    "grouping_rule_version"
  ],
  "properties": {
    "cohort_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the assigned cohort."
    },
    "membership_epoch": {
      "type": ["integer", "string"],
      "description": "Versioned epoch of the learner's cohort membership (e.g. 202641 or '2026-W41')."
    },
    "grouping_rule_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the rule used to assign the cohort."
    }
  },
  "additionalProperties": false
}
